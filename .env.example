# Copie para .env.local e preencha. NUNCA commite .env.local.
# cp .env.example .env.local

# === Supabase ===
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
# Project Settings > API > service_role (SECRETA — só usada no servidor/seed)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# === Banco: acesso direto (só para scripts/backup.sh) ===
# A service_role acima NÃO serve para pg_dump — ela é um JWT das APIs HTTP.
# Dumps precisam da senha do banco, que é outro segredo. Ver docs/OPERACAO.md.
# Preferido: string completa em Dashboard > Connect > Session pooler (porta
# 5432; a 6543/transaction não suporta pg_dump).
DATABASE_URL=
# Alternativa: só a senha — o host é derivado de NEXT_PUBLIC_SUPABASE_URL.
# Dashboard > Settings > Database > Database password.
SUPABASE_DB_PASSWORD=

# === Stripe (REMOVIDO) ===
# O Stripe deixou de ser provedor de pagamento — o checkout roda 100% via
# InfinitePay (Pix). Todo o código foi removido: src/app/api/stripe/,
# src/lib/stripe/, a rota /checkout/success e a dependência `stripe` do npm.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY e STRIPE_SECRET_KEY não são mais lidas por
# nenhum código e podem sair da Vercel.
#
# STRIPE_WEBHOOK_SECRET fica documentada aqui de propósito: mantida nas env
# vars por decisão operacional, mesmo sem nenhum consumidor no código (o
# endpoint /api/stripe/webhook não existe mais). Se o Stripe não voltar,
# é seguro removê-la também.
STRIPE_WEBHOOK_SECRET=whsec_...

# === Meta / Facebook Pixel ===
# Gerenciador de Eventos > Fontes de dados > seu Pixel (só dispara em produção).
NEXT_PUBLIC_META_PIXEL_ID=seu_pixel_id_aqui
# Token da Conversions API (server-side, Purchase no webhook InfinitePay).
# Gerenciador de Eventos > seu Pixel > Configurações > Conversions API >
# "Gerar token de acesso". SECRETO — sem NEXT_PUBLIC_.
META_PIXEL_ACCESS_TOKEN=seu_token_capi_aqui
# OPCIONAL: só para validar. Gerenciador de Eventos > seu Pixel > "Eventos de
# teste" → copie o Test Event Code (TESTxxxxx). Enquanto setada, os eventos vão
# pra aba de teste e NÃO contam como conversão. REMOVA antes de rodar campanha.
META_TEST_EVENT_CODE=

# === Google Analytics 4 ===
# Admin > Fluxos de dados > seu stream > ID de medição (só dispara em produção).
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# === App ===
# Dev: http://localhost:3000
# Produção (Vercel): https://portalaprovus.com.br  (configurado nas env vars da Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Teste gratuito (sessão de convidado) ===
# Segredo para assinar cookies de sessão do trial gratuito (mín. 32 chars).
# O funil /teste não cria conta no Supabase Auth: o visitante é identificado por
# um cookie httpOnly assinado com HS256 (ver src/lib/trial-session.ts). Sem esta
# variável, /api/trial/* responde 500. OBRIGATÓRIA na Vercel (Production E
# Preview). Gere com: openssl rand -base64 32
# Trocar o valor invalida na hora todas as sessões de teste em andamento.
TRIAL_SESSION_SECRET=

# === Admin ===
# Allowlist de admins (separe por vírgula). SEM NEXT_PUBLIC_ — só no servidor.
# Quem está aqui entra no painel /admin já no 1º login (é promovido no banco).
ADMIN_EMAILS=getvellum@gmail.com

# === Observabilidade (opcional) ===
# Webhook do Discord para alertas de erro em tempo real (paid_missing_email,
# payment_not_confirmed, process_failed, etc.). Server do Discord > Config. do
# canal > Integrações > Webhooks > "Novo webhook" > Copiar URL. SEM NEXT_PUBLIC_.
# Se vazia, os erros só vão para o console da Vercel (degrada em silêncio).
DISCORD_WEBHOOK_URL=

# === Rate limiting (recomendado em produção) ===
# Rate limit por IP em /api/infinitepay/checkout e /webhook. Se NENHUM par
# abaixo estiver setado, cai num limiter EM MEMÓRIA (por instância, some no cold
# start) — protege pouco em serverless. Configure um destes para o correto:
#   Upstash Redis (console.upstash.com > Create Database > REST):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#   OU Vercel KV (Storage > Create > KV — injeta estas automaticamente):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
